# Copy to .env and fill in. Everything is optional — with no key, Tryout runs rehearsal agents.

# Live AI agents
ANTHROPIC_API_KEY=
TRYOUT_MODEL=claude-sonnet-5-5
# TRYOUT_AGENT_MAX_TURNS=24
# TRYOUT_AGENT_MAX_MS=240000

# Default mode: auto (live if key present) | live | rehearsal
TRYOUT_MODE=auto
# Rehearsal pacing: 1 = stage speed, 2 = twice as fast
TRYOUT_REHEARSAL_SPEED=1

# Server
PORT=4400
HOST=127.0.0.1
# Public base URL used in consent links (set when hosting so phones can open them)
# TRYOUT_PUBLIC_URL=https://tryout.example.com
# Require x-admin-token for every write action (set this whenever HOST is not 127.0.0.1)
# TRYOUT_ADMIN_TOKEN=change-me

# Sandbox: auto (Docker if available, else local) | docker | local
TRYOUT_SANDBOX=auto
TRYOUT_DOCKER_IMAGE=node:22-alpine
# TRYOUT_TEST_TIMEOUT_MS=20000
# TRYOUT_MEMORY_MB=256

# Default poster shown on stage
TRYOUT_POSTER_NAME=Chris Guerrero
TRYOUT_POSTER_EMAIL=chris@customcomputerslive.com

# Optional: send intro emails automatically via Resend
# RESEND_API_KEY=
# TRYOUT_INTRO_FROM=Tryout <intro@yourdomain.com>

# Optional: higher GitHub API rate limits when adding candidates
# GITHUB_TOKEN=
